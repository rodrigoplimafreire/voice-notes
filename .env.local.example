# --- Supabase -------------------------------------------------------------
# As duas de baixo sao publicas por desenho: vao no bundle do cliente e a RLS
# e quem protege os dados. Nao existe SUPABASE_SERVICE_ROLE_KEY neste projeto,
# e e de proposito — o servidor nunca precisa ver a nota de outra pessoa.
NEXT_PUBLIC_SUPABASE_URL=https://xpojfcklueshbdiiypoo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_w1NZiMCGFlKICzBwaAS62Q_bmEgAKoM

# --- Transcricao ----------------------------------------------------------
# Esta NUNCA vai para o cliente: so a rota de servidor a le.
# Trocar de provedor e trocar duas variaveis, sem mexer em codigo.
TRANSCRIPTION_PROVIDER=groq
GROQ_API_KEY=
# Opcional. Padrao: whisper-large-v3-turbo na Groq, whisper-1 na OpenAI.
# TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# OPENAI_API_KEY=
